# Local synthetic demo only. API and Compose read these same variables.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=tracerisk
POSTGRES_USER=tracerisk
POSTGRES_PASSWORD=tracerisk_local_demo

# Generate a local signing secret (at least 32 characters); do not share .env.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=<generated value>

# Production index is built explicitly with --provider bge; tests use isolated Fake indexes.
EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSIONS=512
EMBEDDING_DISTANCE=cosine
CHUNK_SCHEMA_VERSION=v1
